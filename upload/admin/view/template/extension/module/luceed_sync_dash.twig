            <div role="tabpanel" class="tab-pane" id="poslovnice">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="panel panel-default">
                            <div class="panel-heading darker-bg">
                                {% if store_table_installed %}
                                    <button type="button" id="add-store" class="btn btn-success btn-sm pull-right"><i class="fa fa-plus"></i> Dodaj poslovnicu</button>
                                {% endif %}
                                <h3 class="panel-title"><i class="fa fa-map-marker"></i> Audit Poslovnica</h3>
                            </div>
                            <div class="panel-body">
                                {% if not store_table_installed %}
                                    <div class="alert alert-info">
                                        <strong>Tablica poslovnica nije instalirana.</strong>
                                        Do instalacije frontend koristi postojeću env/JSON konfiguraciju, a legacy Luceed import ostaje dostupan u Sync Manager tabu.
                                    </div>
                                    <p>Pronađeno poslovnica u legacy JSON izvoru: <strong>{{ store_audit.stats.legacy }}</strong></p>
                                    <button type="button" id="install-store-table" class="btn btn-primary"><i class="fa fa-database"></i> Instaliraj tablicu i uvezi postojeće poslovnice</button>
                                {% else %}
                                    <p style="margin-bottom: 15px;">
                                        Ukupno: <strong>{{ store_audit.stats.total }}</strong>,
                                        aktivno: <strong>{{ store_audit.stats.active }}</strong>,
                                        pickup: <strong>{{ store_audit.stats.pickup }}</strong>
                                    </p>

                                    {# Legacy JSON source path intentionally remains server-side only. #}
                                    <div class="panel-group" id="store-warning-accordion" style="margin-bottom: 15px;">
                                        <div class="panel panel-{% if store_audit.warnings %}warning{% else %}success{% endif %}">
                                            <div class="panel-heading">
                                                <h4 class="panel-title">
                                                    <a data-toggle="collapse" data-parent="#store-warning-accordion" href="#store-warnings">
                                                        <i class="fa fa-warning"></i>
                                                        Upozorenja ({{ store_audit.warnings|length }})
                                                        <i class="fa fa-chevron-down pull-right"></i>
                                                    </a>
                                                </h4>
                                            </div>
                                            <div id="store-warnings" class="panel-collapse collapse">
                                                <div class="panel-body">
                                                    {% if store_audit.warnings %}
                                                        <ul style="margin-bottom: 0; padding-left: 20px;">
                                                            {% for warning in store_audit.warnings %}<li>{{ warning }}</li>{% endfor %}
                                                        </ul>
                                                    {% else %}
                                                        Nema upozorenja u konfiguraciji poslovnica.
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped table-condensed" style="font-size: 12px; line-height: 1.2;">
                                            <thead>
                                            <tr>
                                                <th>Šifra</th>
                                                <th>Naziv / adresa</th>
                                                <th>UID</th>
                                                <th>PJ</th>
                                                <th>Def</th>
                                                <th>View</th>
                                                <th>Stores</th>
                                                <th>Pickup</th>
                                                <th>Partner ID</th>
                                                <th>Radno vrijeme</th>
                                                <th>Status</th>
                                                <th></th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            {% for row in store_audit.rows %}
                                                <tr class="{% if not row.status %}text-muted{% endif %}">
                                                    <td><strong>{{ row.code }}</strong></td>
                                                    <td>{{ row.name }}<br><small>{{ row.address }}</small></td>
                                                    <td><small>{{ row.warehouse_uid }}</small></td>
                                                    <td>{{ row.pj_code }}<br><small>{{ row.pj_name }}</small></td>
                                                    <td>{% if row.is_default %}<span class="label label-success">D</span>{% else %}<span class="label label-default">N</span>{% endif %}</td>
                                                    <td>{% if row.is_availability %}<span class="label label-success">D</span>{% else %}<span class="label label-default">N</span>{% endif %}</td>
                                                    <td>{% if row.is_store %}<span class="label label-success">D</span>{% else %}<span class="label label-default">N</span>{% endif %}</td>
                                                    <td>{% if row.is_pickup %}<span class="label label-success">D</span>{% else %}<span class="label label-default">N</span>{% endif %}</td>
                                                    <td>{{ row.partner_id ?: '-' }}</td>
                                                    <td><small>{{ row.working_hours ? row.working_hours|nl2br : '-' }}</small></td>
                                                    <td>{% if row.status %}<span class="label label-success">Aktivna</span>{% else %}<span class="label label-default">Neaktivna</span>{% endif %}</td>
                                                    <td><button type="button" class="btn btn-primary btn-xs js-edit-store" data-store-id="{{ row.store_id }}"><i class="fa fa-pencil"></i></button></td>
                                                </tr>
                                            {% else %}
                                                <tr><td colspan="12" class="text-center">Nema poslovnica.</td></tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

