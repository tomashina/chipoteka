        /**
         *
         */
        function callApi(e, path) {
            let target = e.currentTarget;
            let text = target.text;

            lockTarget(path.charAt(0), $('#' + target.id));

            if (target.id == 'import-luceed-products') {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/' + path + '&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        if (json.status == 200) {
                            document.getElementById('luceed-all-imported').style.display = 'block';
                            document.getElementById('luceed-updating').innerHTML = json.updating;
                            document.getElementById('luceed-inserting').innerHTML = json.inserting;
                            document.getElementById('luceed-total-for').innerHTML = json.updating + json.inserting;
                            document.getElementById('luceed-total').innerHTML = json.total;
                            document.getElementById('luceed-updated').innerHTML = 0;
                            document.getElementById('luceed-inserted').innerHTML = 0;
                            document.getElementById('luceed-error').innerHTML = 0;
                            document.getElementById('luceed-deleted').innerHTML = 0;

                            localStorage.setItem('sync_updated', 0);
                            localStorage.setItem('sync_inserted', 0);
                            localStorage.setItem('sync_error', 0);
                            localStorage.setItem('sync_deleted', 0);

                            localStorage.removeItem('sync_updated');
                            localStorage.removeItem('sync_inserted');
                            localStorage.removeItem('sync_error');
                            localStorage.removeItem('sync_deleted');
                            localStorage.removeItem('sync_total');
                            releseTarget(text, $('#' + target.id));
                            AG_alert.success('Luceed cache je osvježen. Lokalna tablica je spremna za update atributa i redoslijeda.');
                        }
                    }
                });
            } else {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/' + path + '&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        checkResult(json);
                        releseTarget(text, $('#' + target.id));
                    }
                });
            }
        }

        function refreshLuceedProductsCache(onSuccess, onError) {
            $.ajax({
                url: 'index.php?route=extension/module/luceed_sync/importLuceedProducts&user_token={{ user_token }}',
                dataType: 'json',
                success: function(json) {
                    if (json.status == 200) {
                        document.getElementById('luceed-all-imported').style.display = 'block';
                        document.getElementById('luceed-updating').innerHTML = json.updating;
                        document.getElementById('luceed-inserting').innerHTML = json.inserting;
                        document.getElementById('luceed-total-for').innerHTML = json.updating + json.inserting;
                        document.getElementById('luceed-total').innerHTML = json.total;

                        if (typeof onSuccess === 'function') {
                            onSuccess(json);
                        }

                        return;
                    }

                    if (typeof onError === 'function') {
                        onError(json);
                    }
                },
                error: function(xhr) {
                    if (typeof onError === 'function') {
                        onError(xhr);
                    }
                }
            });
        }

        function runOrderStatusSync(e, legacy) {
            let target = e.currentTarget;
            let button = $('#' + target.id);
            let originalText = target.text;
            let processed = 0;
            let updated = 0;
            let modeText = legacy ? 'Stariji statusi' : 'Statusi narudžbi';

            lockTarget('u', button);

            if (legacy) {
                processLegacyBatch('', 0);
            } else {
                processBatch(0);
            }

            function processBatch(cursor) {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/updateOrderStatuses' + (legacy ? '&legacy=1&skip_luceed_statuses=10' : '') + '&cursor=' + cursor + '&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        if (json.status != 200) {
                            checkResult(json);
                            releseTarget(originalText, button);
                            return;
                        }

                        processed += json.processed ? parseInt(json.processed, 10) : 0;
                        updated += json.updated ? parseInt(json.updated, 10) : 0;

                        if (json.empty) {
                            releseTarget(originalText, button);
                            AG_alert.warning(legacy ? 'Nema narudžbi starijih od 60 dana za sinkronizaciju nakon preskakanja statusa 10.' : 'Nema narudžbi iz zadnjih 60 dana za sinkronizaciju.');
                            return;
                        }

                        button.text(modeText + ' ' + updated + '/' + processed);

                        if (json.done) {
                            releseTarget(originalText, button);
                            AG_alert.success(legacy
                                ? 'Sinkronizacija starijih statusa od novijih prema starijima je završena u serijama po 200, bez slanja mailova kupcima i uz preskakanje statusa 10. Ažurirano: ' + updated + '.'
                                : 'Sinkronizacija statusa narudžbi za zadnjih 60 dana je završena u serijama po 200. Ažurirano: ' + updated + '.'
                            );
                            return;
                        }

                        processBatch(json.next_cursor);
                    },
                    error: function(xhr) {
                        releseTarget(originalText, button);
                        let message = 'Došlo je do greške tijekom sinkronizacije statusa narudžbi. Molimo pokušajte ponovo.';

                        if (xhr && xhr.responseText) {
                            try {
                                let parsed = JSON.parse(xhr.responseText);

                                if (parsed.message) {
                                    message = parsed.message;
                                }
                            } catch (e) {
                            }
                        }

                        AG_alert.warning(message);
                    }
                });
            }

            function processLegacyBatch(legacyEnd, legacyCursor) {
                let url = 'index.php?route=extension/module/luceed_sync/updateOrderStatuses&legacy=1&skip_luceed_statuses=10&legacy_cursor=' + legacyCursor + '&user_token={{ user_token }}';

                if (legacyEnd) {
                    url += '&legacy_end=' + encodeURIComponent(legacyEnd);
                }

                $.ajax({
                    url: url,
                    dataType: 'json',
                    success: function(json) {
                        if (json.status != 200) {
                            checkResult(json);
                            releseTarget(originalText, button);
                            return;
                        }

                        processed += json.processed ? parseInt(json.processed, 10) : 0;
                        updated += json.updated ? parseInt(json.updated, 10) : 0;

                        if (json.empty) {
                            releseTarget(originalText, button);
                            AG_alert.warning('Nema narudžbi starijih od 60 dana za sinkronizaciju nakon preskakanja statusa 10.');
                            return;
                        }

                        button.text(modeText + ' ' + updated + '/' + processed);

                        if (json.done) {
                            releseTarget(originalText, button);
                            AG_alert.success('Sinkronizacija starijih statusa od novijih prema starijima je završena u serijama po 200, bez slanja mailova kupcima i uz preskakanje statusa 10. Ažurirano: ' + updated + '.');
                            return;
                        }

                        processLegacyBatch(json.next_legacy_end, json.next_legacy_cursor);
                    },
                    error: function(xhr) {
                        releseTarget(originalText, button);
                        let message = 'Došlo je do greške tijekom sinkronizacije statusa narudžbi. Molimo pokušajte ponovo.';

                        if (xhr && xhr.responseText) {
                            try {
                                let parsed = JSON.parse(xhr.responseText);

                                if (parsed.message) {
                                    message = parsed.message;
                                }
                            } catch (e) {
                            }
                        }

                        AG_alert.warning(message);
                    }
                });
            }
        }

        function runAttributeSync(e) {
            let target = e.currentTarget;
            let button = $('#' + target.id);
            let originalText = target.text;
            let processed = 0;
            let updatedProducts = 0;
            let updatedAttributes = 0;

            lockTarget('u', button);
            processBatch(0);

            function processBatch(cursor) {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/updateProductAttributes&cursor=' + cursor + '&limit=100&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        if (json.status != 200) {
                            checkResult(json);
                            releseTarget(originalText, button);
                            return;
                        }

                        processed += json.processed ? parseInt(json.processed, 10) : 0;
                        updatedProducts += json.products ? parseInt(json.products, 10) : 0;
                        updatedAttributes += json.attributes ? parseInt(json.attributes, 10) : 0;

                        button.text('Atributi ' + processed + '/' + (json.total ? parseInt(json.total, 10) : processed));

                        if (json.done) {
                            releseTarget(originalText, button);
                            AG_alert.success('Atributi su ažurirani na ' + updatedProducts + ' artikala. Ukupno sinkronizirano atributa: ' + updatedAttributes + '.');
                            return;
                        }

                        processBatch(json.next_cursor);
                    },
                    error: function() {
                        releseTarget(originalText, button);
                        AG_alert.warning('Došlo je do greške tijekom batch updatea atributa.');
                    }
                });
            }
        }

        function runAttributeSortOrderSync(e) {
            let target = e.currentTarget;
            let button = $('#' + target.id);
            let originalText = target.text;
            let processed = 0;
            let definitions = 0;
            let products = 0;
            let attributes = 0;

            lockTarget('u', button);
            button.text('Luceed cache...');

            refreshLuceedProductsCache(function() {
                processBatch(0);
            }, function(response) {
                releseTarget(originalText, button);

                if (response && response.status) {
                    checkResult(response);
                    return;
                }

                AG_alert.warning('Došlo je do greške tijekom osvježavanja Luceed cachea.');
            });

            function processBatch(cursor) {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/updateAttributeSortOrders&cursor=' + cursor + '&limit=100&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        if (json.status != 200) {
                            checkResult(json);
                            releseTarget(originalText, button);
                            return;
                        }

                        processed += json.processed ? parseInt(json.processed, 10) : 0;
                        definitions += json.definitions ? parseInt(json.definitions, 10) : 0;
                        products += json.products ? parseInt(json.products, 10) : 0;
                        attributes += json.attributes ? parseInt(json.attributes, 10) : 0;

                        button.text('Redoslijed ' + processed + '/' + (json.total ? parseInt(json.total, 10) : processed));

                        if (json.done) {
                            releseTarget(originalText, button);
                            AG_alert.success('Redoslijed atributa je ažuriran globalno i po artiklu. Definicija: ' + definitions + ', artikala: ' + products + ', atributa: ' + attributes + '.');
                            return;
                        }

                        processBatch(json.next_cursor);
                    },
                    error: function() {
                        releseTarget(originalText, button);
                        AG_alert.warning('Došlo je do greške tijekom batch updatea redoslijeda atributa.');
                    }
                });
            }
        }

        function runDurationStatusCheck(e) {
            let target = e.currentTarget;
            let button = $('#' + target.id);
            let originalText = target.text;
            let processed = 0;
            let sent = 0;

            lockTarget('c', button);

            processBatch(0);

            function processBatch(cursor) {
                $.ajax({
                    url: 'index.php?route=extension/module/luceed_sync/checkOrderStatusDuration&cursor=' + cursor + '&user_token={{ user_token }}',
                    dataType: 'json',
                    success: function(json) {
                        if (json.status != 200) {
                            checkResult(json);
                            releseTarget(originalText, button);
                            return;
                        }

                        processed += json.processed ? parseInt(json.processed, 10) : 0;
                        sent += json.updated ? parseInt(json.updated, 10) : 0;

                        if (json.empty) {
                            releseTarget(originalText, button);
                            AG_alert.warning('Nema narudžbi za provjeru trajanja statusa.');
                            return;
                        }

                        button.text('Provjera ' + sent + '/' + processed);

                        if (json.done) {
                            releseTarget(originalText, button);
                            AG_alert.success('Provjera trajanja statusa je završena u serijama po 200. Poslano mailova: ' + sent + '.');
                            return;
                        }

                        processBatch(json.next_cursor);
                    },
                    error: function(xhr) {
                        releseTarget(originalText, button);
                        let message = 'Došlo je do greške tijekom provjere trajanja statusa. Molimo pokušajte ponovo.';

                        if (xhr && xhr.responseText) {
                            try {
                                let parsed = JSON.parse(xhr.responseText);

                                if (parsed.message) {
                                    message = parsed.message;
                                }
                            } catch (e) {
                            }
                        }

                        AG_alert.warning(message);
                    }
                });
            }
        }


        function updateProducts() {
            let updated = localStorage.getItem('sync_updated') ? localStorage.getItem('sync_updated') : 0;
            let error = localStorage.getItem('sync_error') ? localStorage.getItem('sync_error') : 0;
            let deleted = localStorage.getItem('sync_deleted') ? localStorage.getItem('sync_deleted') : 0;
            let inserted = localStorage.getItem('sync_inserted') ? localStorage.getItem('sync_inserted') : 0;
            let total = localStorage.getItem('sync_total') ? localStorage.getItem('sync_total') : 0;

            $.ajax({
                url: 'index.php?route=extension/module/luceed_sync/updateProduct&user_token={{ user_token }}',
                dataType: 'json',
                success: function(json) {
                    if (json.status == 200) {
                        total++;

                        if (json.message == 'updated') {
                            updated++;

                            localStorage.setItem('sync_updated', updated);
                            document.getElementById('luceed-updated').innerHTML = updated;
                        }

                        if (json.message == 'inserted') {
                            inserted++;

                            localStorage.setItem('sync_inserted', inserted);
                            document.getElementById('luceed-inserted').innerHTML = inserted;
                        }

                        if (json.message == 'error') {
                            error++;

                            localStorage.setItem('sync_error', error);
                            document.getElementById('luceed-error').innerHTML = error;
                        }

                        if (json.message == 'deleted') {
                            deleted++;

                            localStorage.setItem('sync_deleted', deleted);
                            document.getElementById('luceed-deleted').innerHTML = deleted;
                        }

                        if (json.message == 'finish') {
                            document.getElementById('luceed-all-imported').innerHTML = 'Sinkroniziranje završeno..!';
                            releseTarget('Završeno', $('#import-luceed-products'));

                            let data = {
                                updated: updated,
                                inserted: inserted,
                                error: error
                            };

                            $.ajax({
                                url: 'index.php?route=extension/module/luceed_sync/finishUpdateProduct&user_token={{ user_token }}',
                                type: 'POST',
                                data: { data: data},
                                success: function(json) {
                                    checkResult(json);
                                }
                            });

                            location.reload();
                            return;
                        }

                        if (json.message != 'finish' || json.message != 'deleted' || json.message != 'error' || json.message != 'inserted' || json.message != 'updated') {
                            releseTarget('Završeno s Grškom', $('#import-luceed-products'));
                            checkResult({status: 300, message: 'Došlo je do greške, molimo vas da pokušate ponovo.!!!'});
                        }

                        localStorage.setItem('sync_total', total);
                        document.getElementById('luceed-importing').innerHTML = total;

                        updateProducts();
                    }
                }
            });
        }

        /**
         *
         */
        function lockTarget(target, btn) {
            btn.removeClass('btn-info');
            btn.addClass('btn-warning');

            if (target == 'i') {
                btn.html('{{ btn_importing }}');
            }
            if (target == 'u') {
                btn.html('{{ btn_updating }}');
            }
            if (target == 'c') {
                btn.html('{{ btn_checking }}');
            }
        }

        /**
         *
         */
        function releseTarget(text, btn) {
            btn.removeClass('btn-warning');
            btn.addClass('btn-info');
            btn.text(text);
        }

        /**
         *
         */
        function checkResult(result) {
            if (result.status == 200) {
                AG_alert.success(result.message);
            }
            if (result.status == 300) {
                AG_alert.warning(result.message);
            }
        }

        /**
         *
         */
        function hideAlert() {
            setTimeout(() => { $('#alert_placeholder').html(''); }, 6300);
        }


        AG_alert = () => {}
        /**
         * Success alert.
         * @param message
         */
        AG_alert.success = (message) => {
            $('#alert_placeholder').html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + message + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            hideAlert();
        }
        /**
         * Warning or error alert.
         * @param message
         */
        AG_alert.warning = (message) => {
            $('#alert_placeholder').html('<div class="alert alert-warning alert-dismissible"><i class="fa fa-warning"></i> ' + message + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>')
            hideAlert();
        }

    </script>
