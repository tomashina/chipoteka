<style>
    #store-modal .store-status-box {
        align-items: center;
        background: #f8fafc;
        border: 1px solid #d9e2ec;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        margin-bottom: 18px;
        padding: 12px 14px;
    }
    #store-modal .store-status-box.is-active {
        background: #edf9f1;
        border-color: #8fd19e;
    }
    #store-modal .store-status-title { color: #334e68; font-weight: 600; }
    #store-modal .store-status-hint { color: #829ab1; display: block; font-size: 12px; font-weight: 400; margin-top: 2px; }
    #store-modal .store-switch { display: inline-block; height: 26px; margin: 0; position: relative; width: 48px; }
    #store-modal .store-switch input,
    #store-modal .store-option input { opacity: 0; position: absolute; }
    #store-modal .store-switch-slider {
        background: #b8c2cc;
        border-radius: 20px;
        cursor: pointer;
        inset: 0;
        position: absolute;
        transition: .2s ease;
    }
    #store-modal .store-switch-slider:before {
        background: #fff;
        border-radius: 50%;
        bottom: 3px;
        box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
        content: '';
        height: 20px;
        left: 3px;
        position: absolute;
        transition: .2s ease;
        width: 20px;
    }
    #store-modal .store-switch input:checked + .store-switch-slider { background: #27ae60; }
    #store-modal .store-switch input:checked + .store-switch-slider:before { transform: translateX(22px); }
    #store-modal .store-purpose-title { color: #52606d; font-size: 12px; font-weight: 700; letter-spacing: .05em; margin-bottom: 8px; text-transform: uppercase; }
    #store-modal .store-purpose-grid { display: flex; flex-wrap: wrap; gap: 8px; }
    #store-modal .store-option { cursor: pointer; margin: 0; position: relative; }
    #store-modal .store-option-card {
        background: #f5f7fa;
        border: 1px solid #d9e2ec;
        border-radius: 5px;
        color: #52606d;
        display: block;
        font-weight: 600;
        min-width: 130px;
        padding: 10px 12px;
        transition: .15s ease;
    }
    #store-modal .store-option-card i { color: #9fb3c8; margin-right: 6px; }
    #store-modal .store-option input:checked + .store-option-card {
        background: #e8f4fd;
        border-color: #3498db;
        color: #1f6f9f;
        box-shadow: inset 0 0 0 1px #3498db;
    }
    #store-modal .store-option input:checked + .store-option-card i { color: #2980b9; }
    #store-modal .store-option input:focus + .store-option-card,
    #store-modal .store-switch input:focus + .store-switch-slider { box-shadow: 0 0 0 3px rgba(52, 152, 219, .2); }
</style>
