{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-faq" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-faq" class="form-horizontal">
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
              <li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
              <div class="tab-pane" id="language{{ language.language_id }}">
                <div class="form-group required">
                  <label class="col-sm-2 control-label" for="input-name{{ language.language_id }}">{{ entry_name }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="faq_category_description[{{ language.language_id }}][name]" value="{{ faq_category_description[language.language_id] ? faq_category_description[language.language_id].name|escape }}" placeholder="{{ entry_name }}" id="input-name{{ language.language_id }}" class="form-control" />
                    {% if error_name[language.language_id] %}
                      <div class="text-danger">{{ error_name[language.language_id] }}</div>
                    {% endif %}
                  </div>
                </div>

                <div class="form-group">
                  <label class="col-sm-2 control-label">{{ column_questions }}</label>
                  <div class="col-sm-10">
                    <div id="faq-items{{ language.language_id }}" class="faq-items">
                      {% set faq_row = 0 %}
                      {% if faq_item[language.language_id] %}
                        {% for item in faq_item[language.language_id] %}
                          <div id="faq-item-row{{ language.language_id }}-{{ faq_row }}" class="faq-item-card">
                            <div class="faq-item-field">
                              <label for="faq-question-{{ language.language_id }}-{{ faq_row }}">{{ entry_question }}</label>
                              <input type="text" name="faq_item[{{ language.language_id }}][{{ faq_row }}][question]" value="{{ item.question|escape }}" placeholder="{{ entry_question }}" id="faq-question-{{ language.language_id }}-{{ faq_row }}" class="form-control" />
                              {% if error_question[language.language_id][faq_row] %}
                                <div class="text-danger">{{ error_question[language.language_id][faq_row] }}</div>
                              {% endif %}
                            </div>
                            <div class="faq-item-field">
                              <label for="faq-answer-{{ language.language_id }}-{{ faq_row }}">{{ entry_answer }}</label>
                              <textarea name="faq_item[{{ language.language_id }}][{{ faq_row }}][answer]" rows="7" placeholder="{{ entry_answer }}" id="faq-answer-{{ language.language_id }}-{{ faq_row }}" class="form-control faq-answer-editor">{{ item.answer|escape }}</textarea>
                              {% if error_answer[language.language_id][faq_row] %}
                                <div class="text-danger">{{ error_answer[language.language_id][faq_row] }}</div>
                              {% endif %}
                            </div>
                            <div class="faq-item-footer">
                              <div class="faq-item-settings">
                                <div>
                                  <label for="faq-status-{{ language.language_id }}-{{ faq_row }}">{{ entry_status }}</label>
                                  <select name="faq_item[{{ language.language_id }}][{{ faq_row }}][status]" id="faq-status-{{ language.language_id }}-{{ faq_row }}" class="form-control">
                                    <option value="1"{% if item.status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                                    <option value="0"{% if not item.status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
                                  </select>
                                </div>
                                <div>
                                  <label for="faq-sort-order-{{ language.language_id }}-{{ faq_row }}">{{ entry_sort_order }}</label>
                                  <input type="number" name="faq_item[{{ language.language_id }}][{{ faq_row }}][sort_order]" value="{{ item.sort_order }}" id="faq-sort-order-{{ language.language_id }}-{{ faq_row }}" class="form-control" />
                                </div>
                              </div>
                              <button type="button" data-row="faq-item-row{{ language.language_id }}-{{ faq_row }}" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger faq-item-remove"><i class="fa fa-minus-circle"></i> <span>{{ button_remove }}</span></button>
                            </div>
                          </div>
                          {% set faq_row = faq_row + 1 %}
                        {% endfor %}
                      {% endif %}
                    </div>
                    <div class="faq-items-actions">
                      <span class="help-block">{{ text_questions_help }}</span>
                      <button type="button" onclick="addFaqItem({{ language.language_id }});" class="btn btn-primary"><i class="fa fa-plus-circle"></i> {{ button_add_question }}</button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <hr />

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                <option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<link href="view/javascript/summernote/summernote.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/summernote/summernote.js"></script>

<style>
.faq-items {
  display: grid;
  gap: 18px;
}
.faq-item-card {
  padding: 20px;
  background: #fdfdfd;
  border: 1px solid #dcdcdc;
  border-left: 4px solid #e31318;
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .04);
}
.faq-item-field + .faq-item-field {
  margin-top: 18px;
}
.faq-item-field > label,
.faq-item-settings label {
  display: block;
  margin-bottom: 7px;
  color: #454545;
  font-weight: 600;
}
.faq-item-card .note-editor {
  margin-bottom: 0;
  border-color: #ccc;
}
.faq-item-card .note-editable {
  min-height: 150px;
  background: #fff;
}
.faq-item-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-top: 18px;
  padding-top: 16px;
  border-top: 1px solid #e8e8e8;
}
.faq-item-settings {
  display: flex;
  gap: 14px;
}
.faq-item-settings > div:first-child {
  width: 180px;
}
.faq-item-settings > div:last-child {
  width: 130px;
}
.faq-items-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 14px;
}
.faq-items-actions .help-block {
  margin: 0;
}
@media (max-width: 767px) {
  .faq-item-card {
    padding: 15px;
  }
  .faq-item-footer,
  .faq-items-actions {
    align-items: stretch;
    flex-direction: column;
  }
  .faq-item-settings > div {
    width: 50% !important;
  }
  .faq-item-remove,
  .faq-items-actions .btn {
    width: 100%;
  }
}
</style>

<script type="text/javascript"><!--
var faqRows = {};
{% for language in languages %}
faqRows[{{ language.language_id }}] = {{ faq_item[language.language_id] ? faq_item[language.language_id]|length : 0 }};
{% endfor %}

function initializeFaqEditor(editor) {
  var $editor = $(editor);

  if ($editor.next('.note-editor').length) {
    return;
  }

  $editor.summernote({
    disableDragAndDrop: true,
    height: 180,
    minHeight: 140,
    emptyPara: '',
    toolbar: [
      ['font', ['bold', 'italic', 'underline', 'clear']],
      ['para', ['ul', 'ol', 'paragraph']],
      ['insert', ['link']],
      ['view', ['codeview']]
    ]
  });
}

function addFaqItem(languageId) {
  var row = faqRows[languageId]++;
  var editorId = 'faq-answer-' + languageId + '-' + row;
  var html = '<div id="faq-item-row' + languageId + '-' + row + '" class="faq-item-card">';
  html += '<div class="faq-item-field"><label for="faq-question-' + languageId + '-' + row + '">{{ entry_question|escape('js') }}</label><input type="text" name="faq_item[' + languageId + '][' + row + '][question]" value="" placeholder="{{ entry_question|escape('js') }}" id="faq-question-' + languageId + '-' + row + '" class="form-control" /></div>';
  html += '<div class="faq-item-field"><label for="' + editorId + '">{{ entry_answer|escape('js') }}</label><textarea name="faq_item[' + languageId + '][' + row + '][answer]" rows="7" placeholder="{{ entry_answer|escape('js') }}" id="' + editorId + '" class="form-control faq-answer-editor"></textarea></div>';
  html += '<div class="faq-item-footer"><div class="faq-item-settings">';
  html += '<div><label for="faq-status-' + languageId + '-' + row + '">{{ entry_status|escape('js') }}</label><select name="faq_item[' + languageId + '][' + row + '][status]" id="faq-status-' + languageId + '-' + row + '" class="form-control"><option value="1" selected="selected">{{ text_enabled|escape('js') }}</option><option value="0">{{ text_disabled|escape('js') }}</option></select></div>';
  html += '<div><label for="faq-sort-order-' + languageId + '-' + row + '">{{ entry_sort_order|escape('js') }}</label><input type="number" name="faq_item[' + languageId + '][' + row + '][sort_order]" value="0" id="faq-sort-order-' + languageId + '-' + row + '" class="form-control" /></div>';
  html += '</div><button type="button" data-row="faq-item-row' + languageId + '-' + row + '" data-toggle="tooltip" title="{{ button_remove|escape('js') }}" class="btn btn-danger faq-item-remove"><i class="fa fa-minus-circle"></i> <span>{{ button_remove|escape('js') }}</span></button></div>';
  html += '</div>';

  $('#faq-items' + languageId).append(html);
  initializeFaqEditor('#' + editorId);
}

$(document).on('click', '.faq-item-remove', function() {
  var $row = $('#' + $(this).data('row'));
  var $editor = $row.find('.faq-answer-editor');

  if ($editor.next('.note-editor').length) {
    $editor.summernote('destroy');
  }

  $row.remove();
});

$(document).ready(function() {
  $('.faq-answer-editor').each(function() {
    initializeFaqEditor(this);
  });

  $('#form-faq').on('submit', function() {
    $('.faq-answer-editor').each(function() {
      var $editor = $(this);

      if ($editor.next('.note-editor').length) {
        $editor.val($editor.summernote('code'));
      }
    });
  });

  $('#language a:first').tab('show');
});
//--></script>
{{ footer }}
