<div id="total-content" >
  {% if products  %}
	   <div class="widget mb-3">
	     <h2 class="h6 text-center mb-4">{% if is_pickup_reservation %}Sažetak rezervacije{% else %}Sažetak narudžbe{% endif %}</h2>
	   </div>

            <ul class="list-unstyled fs-sm pb-2 border-bottom">
              {% for total in totals %}
                {% if total.title!='Ukupno'  %}

                      {% set total_title = is_pickup_reservation ? total.title|replace({'Narudžba':'Rezervacija', 'narudžbu':'rezervaciju', 'narudžbe':'rezervacije', 'narudžba':'rezervacija', 'Naruči':'Rezerviraj', 'naruči':'rezerviraj'}) : total.title %}
	                  <li class="d-flex justify-content-between align-items-center"><span class="me-2">{{ total_title }}</span><span class="text-end">{{ total.text }}</span></li>

                {% endif %}
              {% endfor %}
            </ul>

            {% for total in totals %}
              {% if total.title=='Ukupno'  %}

                <h3 class="fw-normal text-center my-4">{{ total.text }}</h3>
              {% endif %}
            {% endfor %}



    {% endif %}


</div>





