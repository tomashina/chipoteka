{{ header }}
<main class="offcanvas-enabled">
  <div class="account-login-page account-register-page">
    <div class="account-login-page__shell">
      <header class="account-login-page__heading account-register-page__heading">
        <h1 id="page-title">{{ heading_title }}</h1>
        <p class="account-register-page__lead">{{ text_account_already }}</p>
        <nav aria-label="{{ text_breadcrumb|default('Breadcrumb') }}">
          <ol class="account-login-breadcrumb">
            {% for breadcrumb in breadcrumbs %}
              <li{% if loop.last %} class="is-current" aria-current="page"{% endif %}>
                {% if loop.first %}
                  <a href="{{ breadcrumb.href }}" aria-label="{{ text_home_label }}"><i class="fas fa-home" aria-hidden="true"></i></a>
                {% elseif loop.last %}
                  <span>{{ breadcrumb.text }}</span>
                {% else %}
                  <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                {% endif %}
              </li>
            {% endfor %}
          </ol>
        </nav>
      </header>

      {{ content_top }}

      {% if error_warning %}
        <div class="alert alert-danger account-register-warning" role="alert">
          <i class="fa fa-exclamation-circle" aria-hidden="true"></i> {{ error_warning }}
        </div>
      {% endif %}

      <div id="content" class="account-register-layout">
        <section class="account-login-card account-register-card" aria-labelledby="register-card-title">
          <div class="account-login-card__intro account-register-card__intro">
            <img class="account-register-card__intro-icon" src="catalog/view/theme/basel/image/account/bag-register.svg" alt="" width="76" height="86" aria-hidden="true">
            <div>
              <h2 id="register-card-title">{{ text_register_card_title }}</h2>
              <p>{{ text_register_intro }}</p>
            </div>
          </div>

		  {% if success %}
			<div class="alert alert-success" role="status"><i class="fa fa-check-circle" aria-hidden="true"></i> {{ success }}</div>
		  {% endif %}

		  {% if google_registration %}
			<div class="account-google-registration-status">
			  <span class="account-google-mark" aria-hidden="true">G</span>
			  <div>
				<strong>{{ text_google_verified }}</strong>
				<p>{{ text_google_password_help }}</p>
			  </div>
			  <a href="{{ google_cancel }}">{{ text_use_email_registration }}</a>
			</div>
		  {% elseif google_registration_enabled %}
			<a class="account-google-button" href="{{ google_register }}" aria-label="{{ text_google_register }}">
			  <span class="account-google-mark" aria-hidden="true">G</span>
			  <span>{{ text_google_register }}</span>
			</a>
			<div class="account-login-divider account-register-divider"><span>{{ text_or }}</span></div>
		  {% endif %}

          <form action="{{ action }}" method="post" enctype="multipart/form-data" class="account-register-form" novalidate>
            <section class="account-register-section" id="account" aria-labelledby="podaci_title">
              <div class="account-register-section__heading">
                <div>
                  <span>{{ text_account_type }}</span>
                  <h3 id="podaci_title">{{ text_your_details }}</h3>
                </div>
                <p>{{ text_required_note }}</p>
              </div>

              {% if customer_groups|length > 1 %}
                <div class="account-register-types" role="radiogroup" aria-label="{{ text_account_type }}">
                  {% for customer_group in customer_groups %}
                    <label class="account-register-type" for="cg{{ customer_group.customer_group_id }}">
                      <input type="radio" name="customer_group_id" value="{{ customer_group.customer_group_id }}" id="cg{{ customer_group.customer_group_id }}"{% if customer_group.customer_group_id == customer_group_id %} checked="checked"{% endif %}>
                      <span>
                        <i class="fal {% if customer_group.customer_group_id == 2 %}fa-building{% else %}fa-user{% endif %}" aria-hidden="true"></i>
                        {{ customer_group.name }}
                      </span>
                    </label>
                  {% endfor %}
                </div>
              {% else %}
                {% for customer_group in customer_groups %}
                  <input type="hidden" name="customer_group_id" value="{{ customer_group.customer_group_id }}">
                {% endfor %}
              {% endif %}

              <div class="account-register-fields account-register-company-fields">
                {% for custom_field in custom_fields %}
                  {% if custom_field.type == 'text' %}
                    <div id="custom-field{{ custom_field.custom_field_id }}" class="account-register-field custom-field pravna" data-sort="{{ custom_field.sort_order }}">
                      <label for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }} <span aria-hidden="true">*</span></label>
                      <div class="account-login-control">
                        <i class="fal fa-building" aria-hidden="true"></i>
                        <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder="{{ custom_field.name }}" id="input-custom-field{{ custom_field.custom_field_id }}" autocomplete="organization">
                      </div>
                      {% if error_custom_field[custom_field.custom_field_id] %}
                        <div class="account-register-error">{{ error_custom_field[custom_field.custom_field_id] }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

              <h4 class="account-register-subheading pravna">{{ text_contact_person }}</h4>

              <div class="account-register-fields">
                <div class="account-register-field{% if error_firstname %} has-error{% endif %}">
                  <label for="input-firstname">{{ entry_firstname }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-user" aria-hidden="true"></i>
                    <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" autocomplete="given-name" required{% if error_firstname %} aria-invalid="true"{% endif %}>
                  </div>
                  {% if error_firstname %}<div class="account-register-error">{{ error_firstname }}</div>{% endif %}
                </div>

                <div class="account-register-field{% if error_lastname %} has-error{% endif %}">
                  <label for="input-lastname">{{ entry_lastname }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-user" aria-hidden="true"></i>
                    <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" autocomplete="family-name" required{% if error_lastname %} aria-invalid="true"{% endif %}>
                  </div>
                  {% if error_lastname %}<div class="account-register-error">{{ error_lastname }}</div>{% endif %}
                </div>

                <div class="account-register-field{% if error_email %} has-error{% endif %}">
                  <label for="input-email">{{ entry_email }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
					<input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" autocomplete="email" inputmode="email" required{% if google_registration %} readonly aria-describedby="google-email-status"{% endif %}{% if error_email %} aria-invalid="true"{% endif %}>
                  </div>
				  {% if google_registration %}<div class="account-google-email-status" id="google-email-status"><i class="fas fa-check-circle" aria-hidden="true"></i> {{ text_google_email_verified }}</div>{% endif %}
                  {% if error_email %}<div class="account-register-error">{{ error_email }}</div>{% endif %}
                </div>

                <div class="account-register-field{% if error_telephone %} has-error{% endif %}">
                  <label for="input-telephone">{{ entry_telephone }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-phone" aria-hidden="true"></i>
                    <input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ text_phone_placeholder }}" id="input-telephone" autocomplete="tel" inputmode="tel" required{% if error_telephone %} aria-invalid="true"{% endif %}>
                  </div>
                  {% if error_telephone %}<div class="account-register-error">{{ error_telephone }}</div>{% endif %}
                </div>
              </div>
            </section>

			{% if not google_registration %}
			<section class="account-register-section" aria-labelledby="password-section-title">
              <div class="account-register-section__heading account-register-section__heading--simple">
                <h3 id="password-section-title">{{ text_your_password }}</h3>
              </div>

              <div class="account-register-fields">
                <div class="account-register-field{% if error_password %} has-error{% endif %}">
                  <label for="input-password">{{ entry_password }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-lock-alt" aria-hidden="true"></i>
                    <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" autocomplete="new-password" required{% if error_password %} aria-invalid="true"{% endif %}>
                    <button class="account-password-toggle" type="button" data-password-target="input-password" aria-label="{{ text_show_password }}" aria-pressed="false">
                      <i class="fal fa-eye-slash" aria-hidden="true"></i>
                    </button>
                  </div>
                  {% if error_password %}<div class="account-register-error">{{ error_password }}</div>{% endif %}
                </div>

                <div class="account-register-field{% if error_confirm %} has-error{% endif %}">
                  <label for="input-confirm">{{ entry_confirm }} <span aria-hidden="true">*</span></label>
                  <div class="account-login-control">
                    <i class="fas fa-lock-alt" aria-hidden="true"></i>
                    <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" autocomplete="new-password" required{% if error_confirm %} aria-invalid="true"{% endif %}>
                    <button class="account-password-toggle" type="button" data-password-target="input-confirm" aria-label="{{ text_show_password }}" aria-pressed="false">
                      <i class="fal fa-eye-slash" aria-hidden="true"></i>
                    </button>
                  </div>
                  {% if error_confirm %}<div class="account-register-error">{{ error_confirm }}</div>{% endif %}
                </div>
              </div>
			</section>
			{% endif %}

            <div class="d-none" aria-hidden="true">
              <input type="radio" name="newsletter" value="1"{% if newsletter %} checked="checked"{% endif %}>
              <input type="radio" name="newsletter" value="0"{% if not newsletter %} checked="checked"{% endif %}>
            </div>

            {% if captcha %}
              <div class="account-register-captcha">{{ captcha }}</div>
            {% endif %}

            {% if text_agree %}
              <label class="account-register-agree">
                <input type="checkbox" name="agree" value="1"{% if agree %} checked="checked"{% endif %}>
                {{ text_agree }}
              </label>
            {% endif %}

            <div class="account-login-actions account-register-actions">
              <button class="account-login-cta" type="submit">
                <i class="fal fa-user-plus" aria-hidden="true"></i>
                <span>{{ text_register }}</span>
              </button>
            </div>
          </form>
        </section>

      </div>

      {{ content_bottom }}
    </div>
  </div>

  <script>
    (function ($) {
      var personalTitle = '{{ text_your_details|e('js') }}';
      var companyTitle = '{{ text_company_details|e('js') }}';
      var showPasswordText = '{{ text_show_password|e('js') }}';
      var hidePasswordText = '{{ text_hide_password|e('js') }}';

      function selectedCustomerGroup() {
        return $('input[name="customer_group_id"]:checked').val() || $('input[name="customer_group_id"]').val();
      }

      function syncCustomerType() {
        var isCompany = selectedCustomerGroup() === '2';
        $('.pravna').toggle(isCompany);
        $('#podaci_title').text(isCompany ? companyTitle : personalTitle);
      }

      $('#input-email').on('keydown', function (event) {
        if (event.which === 32) {
          event.preventDefault();
        }
      }).on('change', function () {
        this.value = this.value.replace(/\s/g, '');
      });

      $('.account-password-toggle').on('click', function () {
        var button = $(this);
        var input = document.getElementById(button.attr('data-password-target'));

        if (!input) {
          return;
        }

        var passwordIsVisible = input.type === 'text';
        input.type = passwordIsVisible ? 'password' : 'text';
        button.attr('aria-pressed', passwordIsVisible ? 'false' : 'true');
        button.attr('aria-label', passwordIsVisible ? showPasswordText : hidePasswordText);
        button.find('i').attr('class', passwordIsVisible ? 'fal fa-eye-slash' : 'fal fa-eye');
      });

      $('input[name="customer_group_id"]').on('change', function () {
        syncCustomerType();

        $.ajax({
          url: 'index.php?route=account/register/customfield&customer_group_id=' + encodeURIComponent(this.value),
          dataType: 'json',
          success: function (json) {
            $('.custom-field').hide().removeClass('required');

            for (var i = 0; i < json.length; i++) {
              var customField = json[i];
              var field = $('#custom-field' + customField.custom_field_id);

              field.show();

              if (customField.required) {
                field.addClass('required');
              }
            }

            syncCustomerType();
          }
        });
      });

      syncCustomerType();
      $('input[name="customer_group_id"]:checked').trigger('change');
    }(jQuery));
  </script>

{{ footer }}
