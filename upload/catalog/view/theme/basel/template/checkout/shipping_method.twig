{% if error_warning %}
  <div class="alert alert-primary alert-dismissible fade show mt-3" role="alert">
    {{ error_warning }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
{% endif %}
{% if shipping_methods %}
  <h2 class="h6 pb-3 mt-3 mb-2">{{ text_shipping_method }}</h2>
  <div class="table-responsive">
    <table class="table table-hover fs-sm border-top">
      <thead>
      <tr>

        <th class="align-middle">Način dostave</th>

        <th class="align-middle">Cijena</th>
      </tr>
      </thead>
      <tbody>
  {% for shipping_method in shipping_methods %}
    {% if not shipping_method.error %}
      {% for quote in shipping_method.quote %}
        {% set is_pickup_quote = quote.code|slice(0,14) == 'pickup.pickup_' %}
        <tr {% if is_pickup_quote and not loop.first %}class="pickup-hidden-option" style="display:none"{% endif %}>
          <td>

            <div class="form-check mb-0 mt-1">
              {% if quote.code == code or not code %}
                {% set code = quote.code %}
              {% endif %}
              <label class="form-check-label" for="{{ quote.code }}">
                <input class="form-check-input" type="radio" name="shipping_method" id="{{ quote.code }}" value="{{ quote.code }}" {% if quote.code == code %}checked="checked"{% endif %} />
                <span class="text-dark fw-medium me-3">{% if is_pickup_quote %}{{ shipping_method.title }}{% else %}{{ quote.title }}{% endif %}</span>
              </label>


            </div>




          </td>
         <!-- <td class="align-middle"><span class="text-dark fw-medium">{{ shipping_method.title }}</span><br><span class="text-muted"> {{ quote.title }}</span></td> -->
          <td class="align-middle">{{ quote.text }}</td>
        </tr>


          {% if  quote.code == 'weight.weight_5' %}

          <tr id="boxbox" style="display:none">
            <td colspan="3"  style="border-bottom-width: 0px;">

              <div class="shipping-data shipping_info shipping_info_1" >
            <div id="drop-parcel-shop">
              <a href="javascript:" class="boxnow-map-widget-button btn btn-primary" style="color: #fff;padding: 10px 20px;margin-bottom: 10px;display: block;">Odaberite BOX NOW lokaciju</a>
              <div id="boxnowmap" style="z-index:1880;position:fixed"></div>
              <div id="errorbox"></div>
              <input type="text" name="boxnow" class="form-control" value="{{ boxnow }}" id="boxnow" readonly />

            </div>
              <small>{{ quote.description }}</small>
            </div>
          </td>
         </tr>

      <script>
        jQuery(function($) {



          var radioButtons = document.querySelectorAll('input[name="shipping_method"]');

          for(var radioButton of radioButtons){
            radioButton.addEventListener('change', showSelected);

            if (radioButton.checked) {
              let mook_event = { currentTarget: { value: radioButton.value }};
              showSelected(mook_event);
            }
          }

          function showSelected(e) {
            let selected = e.currentTarget.value;

            if (selected != 'weight.weight_5') {
              $('#drop-parcel-shop').hide();

              $('#boxnow').val('');
              $('.dizb').prop('disabled', false);
            } else {
              $('#drop-parcel-shop').show();
              $('#boxbox').show();
              $('.dizb').prop('disabled', true);

              $('#errorbox').html('<div style="color: red">Morate odabrati dostavno mjesto!</div>')
            }
          }


        });
      </script>

          {% endif %}



      {% endfor %}
    {% else %}
      <tr>
        <div class="alert alert-primary alert-dismissible fade show" role="alert">
          {{ shipping_method.error }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </tr>
    {% endif %}


  {% endfor %}

      </tbody>
    </table>


  </div>

{% endif %}

{% if pickup_stores_enabled and pickup_stores %}
<div id="pickup-store-select-wrapper" class="mt-3 mb-3" style="display: none;">
  <label class="form-label" for="pickup-store-select">Odaberite poslovnicu za preuzimanje</label>
  <select id="pickup-store-select" class="form-select">
    {% for store in pickup_stores %}
      <option value="{{ store.shipping_code }}" {% if store.shipping_code == code %}selected="selected"{% endif %}>{{ store.name }}{% if store.address %} - {{ store.address }}{% endif %}</option>
    {% endfor %}
  </select>
</div>
{% endif %}
<div class="form-group mb-3 required">
  <label class="form-label" for="input-payment-firstname">Dodatna napomena</label>
  <textarea class="form-control" name="comment" style="height: 120px;" placeholder="Ukoliko imate dodatnih napomena vezano uz isporuku molimo upišite ovdje">{{ comment }}</textarea>
</div>



<div class="d-flex pt-4 mt-3">
  <div class="w-50 pe-3"><a class="btn btn-outline-primary d-flex align-items-center justify-content-center w-100" href="{{ checkout }}"><i class="fal fa-chevron-left mt-sm-0 me-1"></i><span class="d-none d-sm-inline">Vaši podaci</span><span class="d-inline d-sm-none">Vaši podaci</span></a></div>
  <div class="w-50 ps-2"><button type="button"  value="{{ button_continue }}" id="button-shipping-method" onclick="window.scrollTo(0, 0)" class="btn btn-primary d-flex align-items-center justify-content-center w-100 dizb" ><span class="d-none d-sm-inline">Način plaćanja</span><span class="d-inline d-sm-none">Način plaćanja</span><i class="fal fa-chevron-right mt-sm-0 ms-1"></i></button></div>
</div>


