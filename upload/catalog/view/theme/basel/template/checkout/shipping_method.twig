        });
        $('#errorbox').html('<div style="color: green">Uspješno ste odabrali mjesto dostave!</div>')

        $('.dizb').prop('disabled', false);

      }


    }
  };
  (function (d) { var e = d.createElement("script"); e.src = "https://widget-cdn.boxnow.hr/map-widget/client/v5.js"; e.async = true; e.defer = true; d.getElementsByTagName("head")[0].appendChild(e); })(document);
</script>

{% if pickup_stores_enabled and pickup_stores %}
<script type="text/javascript">
  jQuery(function($) {
    var $pickupSelectWrapper = $('#pickup-store-select-wrapper');
    var $pickupSelect = $('#pickup-store-select');
    var pickupPrefix = 'pickup.pickup_';
    var select2CssId = 'ag-pickup-select2-css';
    var select2JsFlag = '__agPickupSelect2Loading';
    var select2ReadyEvent = 'ag.pickup.select2.ready';
    var select2CssUrl = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css';
    var select2JsUrl = 'https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js';

    if (!$pickupSelectWrapper.length || !$pickupSelect.length) {
      return;
    }

    function initSelect2() {
      if (!$.fn.select2) {
        return;
      }

      if (!$pickupSelect.data('select2')) {
        $pickupSelect.select2({
          width: '100%',
          placeholder: 'Odaberite poslovnicu'
        });
      }
    }

    function loadSelect2(callback) {
      if ($.fn.select2) {
        callback();
        return;
      }

      if (!document.getElementById(select2CssId)) {
        $('<link/>', {
          id: select2CssId,
          rel: 'stylesheet',
          href: select2CssUrl
        }).appendTo('head');
      }

      if (window[select2JsFlag]) {
        $(document).one(select2ReadyEvent, callback);
        return;
      }

      window[select2JsFlag] = true;

      $.getScript(select2JsUrl)
        .always(function() {
          window[select2JsFlag] = false;
          $(document).trigger(select2ReadyEvent);
          callback();
        });
    }

    function getPickupRadios() {
      return $('input[name="shipping_method"][value^="' + pickupPrefix + '"]');
    }

    function refreshPickupSelect() {
      var selected = $('input[name="shipping_method"]:checked').val() || '';
      var isPickup = selected.indexOf(pickupPrefix) === 0;
      var $pickupRadios = getPickupRadios();

      if (!$pickupRadios.length) {
        $pickupSelectWrapper.hide();
        return;
      }

      if (isPickup) {
        if (!$pickupRadios.filter('[value="' + selected + '"]').length) {
          selected = $pickupSelect.val() || $pickupRadios.first().val();
          $pickupRadios.prop('checked', false);
          $pickupRadios.filter('[value="' + selected + '"]').prop('checked', true);
        }

        $pickupSelectWrapper.show();

        if ($pickupSelect.val() !== selected) {
          $pickupSelect.val(selected);
          if ($.fn.select2 && $pickupSelect.data('select2')) {
            $pickupSelect.trigger('change.select2');
          }
        }
      } else {
        $pickupSelectWrapper.hide();
      }
    }

    $(document).off('change.pickupStores', 'input[name="shipping_method"]').on('change.pickupStores', 'input[name="shipping_method"]', refreshPickupSelect);

    $pickupSelect.off('change.pickupStores').on('change.pickupStores', function() {
      var selected = $(this).val() || '';
      var $target = getPickupRadios().filter('[value="' + selected + '"]');

      if ($target.length) {
        $target.prop('checked', true).trigger('change');
      }
    });

    loadSelect2(function() {
      initSelect2();
      refreshPickupSelect();
    });

    refreshPickupSelect();
  });
</script>
{% endif %}
