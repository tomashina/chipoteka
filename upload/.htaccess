# 1.To use URL Alias you need to be running apache with mod_rewrite enabled.

# 2. In your opencart directory rename htaccess.txt to .htaccess.

# For any support issues please visit: http://www.opencart.com

Options +FollowSymlinks

# Prevent Directory listing
Options -Indexes

# Prevent Direct Access to files
<FilesMatch "(?i)(\.tpl|\.twig|\.ini|\.log|^(?!(robots|llms|ea81e5ea0e88a48ec19291ea3e853459)\.txt$).*\.txt$)">
 Require all denied
## For apache 2.2 and older, replace "Require all denied" with these two lines :
# Order deny,allow
# Deny from all
</FilesMatch>

# SEO URL Settings
RewriteEngine On
# If your opencart installation does not run on the main web folder make sure you folder it does run in ie. / becomes /shop/


Redirect 301 /nova-poslovnica-varazdin https://promo.chipoteka.hr/chipoteka-varazdin-otvorenje/

Redirect 301 /jer-ruze-nemaju-garanciju-promo-blog https://promo.chipoteka.hr/jer-ruze-nemaju-garanciju-akcija/

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^images\.chipoteka\.hr$ [NC]
RewriteCond %{HTTP_HOST} !^chipoteka\.pluschip\.lin29.host25\.com$ [NC]

RewriteRule ^(.*) https://www.chipoteka.hr%{REQUEST_URI} [R=301,L,NE]

RewriteBase /





RewriteRule ^.?artikl/[\w-]+/(.+)-(\d+)/?$ /$1-$2 [R=301,L]

RewriteCond %{QUERY_STRING} ^route=common/home$
RewriteCond %{REQUEST_METHOD} !^POST$
RewriteRule ^index\.php$ http://%{HTTP_HOST}? [R=301,L]

RewriteRule ^(.*)cart/add/(.*)$ https://%{HTTP_HOST}? [R=301,L]

RewriteCond %{QUERY_STRING} search=dyson
RewriteRule ^index\.php$ /dyson-demo-zone/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} search=Dyson
RewriteRule ^index\.php$ /dyson-demo-zone/? [R=301,L,NE]

RewriteCond %{QUERY_STRING} search=DYSON
RewriteRule ^index\.php$ /dyson-demo-zone/? [R=301,L,NE]

RewriteRule ^search/([^/]*)$ index.php?route=product/search&%{QUERY_STRING} [L]

RewriteRule ^sitemap-index.xml$ index.php?route=extension/feed/boost_sitemap [L]

RewriteRule ^usporedi.xml$ index.php?route=extension/feed/usporedi [L]



RewriteRule ^sitemap.xml$ index.php?route=extension/feed/simple_google_sitemap [L]
RewriteRule ^googlebase.xml$ index.php?route=extension/feed/google_base [L]
RewriteRule ^openai-products\.jsonl$ index.php?route=extension/feed/openai_product_feed [L,QSA]
RewriteRule ^llms\.txt$ index.php?route=information/ai_context/llms [L,QSA]
RewriteRule ^ai-context/?$ index.php?route=information/ai_context [L,QSA]
RewriteRule ^system/storage/(.*) index.php?route=error/not_found [L]
RewriteRule ^poslovnice index.php?route=information/contact [L]
RewriteRule ^brandovi index.php?route=product/manufacturer [L]
RewriteRule ^servis index.php?route=information/contact&name=servis [L]
RewriteRule ^veleprodaja index.php?route=information/contact&name=veleprodaja [L]

RewriteRule ^files/products.xml index.php?route=extension/feed/nabavanet [L]

RewriteRule ^ronis.xml index.php?route=extension/feed/ronis [L]
RewriteRule ^bazzar.xml index.php?route=extension/feed/bazzar [L]

RewriteRule	^super-deal	https://www.chipoteka.hr/hit-cijena		[L,R=301]

RewriteRule	^akcijska-kamera-gopro-hero-11-black-creator-edition-53k-8999121102	https://www.chipoteka.hr/akcijska-kamera-gopro-hero-11-black-creator-edition-53k-chdfb-111-eu-8999121102		[L,R=301]
RewriteRule	^akcijska-kamera-gopro-hero-11-black-27-mp-53k-crna-8999121101	https://www.chipoteka.hr/akcijska-kamera-gopro-hero-11-black-27-mp-53k-crna-chdhx-111-rw-8999121101	[L,R=301]
RewriteRule	^akcijska-kamera-gopro-hero-10-black-23-mp-53k-1720-mah-baterija-vodootporna-crna-8999121076	https://www.chipoteka.hr/akcijska-kamera-gopro-hero-10-black-23-mp-53k-1720-mah-baterija-vodootporna-crna-chdhx-101-rw-8999121076	[L,R=301]

